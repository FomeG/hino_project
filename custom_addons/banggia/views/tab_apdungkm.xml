<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tab_apdungkm_pricelist" model="ir.ui.view">
        <field name="name">view.tab.apdungkm.pricelist</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pricelist_config']" position="after">
                <page name="applykm" string="Apply KM">
                    <group>
                        <group>
                            <field name="x_from_km"/>
                            <field name="x_to_km"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>