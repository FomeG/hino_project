<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tab_apdungdaily_pricelist" model="ir.ui.view">
        <field name="name">view.tab.dealers.pricelist</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pricelist_config']" position="after">
                <page name="applyformerchants" string="Apply for dealers">
                    <group>
                        <group>
                            <field name="x_apply_for_dealer" widget="radio"/>
                            <field name="x_dealer_ids" 
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                invisible="x_apply_for_dealer != 'specific'"
                                required="x_apply_for_dealer == 'specific'">
                                <tree>
                                    <field name="name"/>
                                    <field name="company_registry"/>  <!-- Company code -->
                                </tree>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>