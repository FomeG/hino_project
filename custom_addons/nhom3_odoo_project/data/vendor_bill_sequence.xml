<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_vendor_bill" model="ir.sequence">
            <field name="name">Vendor Bill Sequence</field>
            <field name="code">vendor.bill.sequence</field>
            <field name="prefix">BILL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="yearly_prefix">True</field>  <!-- Reset sequence mỗi năm -->
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>