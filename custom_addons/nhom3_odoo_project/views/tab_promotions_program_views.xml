<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_inherit_promotion" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.promotion</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='repair_notes']" position="replace">
                <page string="Promotions" name="promotions">
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="x_vehicle_plate" readonly="1"/>
                            <field name="x_km_at_repair"
                                   readonly="state != 'draft'"
                                   required="1"/>
                        </group>
                        <group>
                            <field name="x_pricelist_id" readonly="1"
                                   domain="['|',
                                          '&amp;',
                                          ('x_apply_for', '=', 'specific'),
                                          ('x_customer_ids', 'in', partner_id),
                                          '|',
                                          '&amp;',
                                          ('x_apply_for_vehicles', '=', 'specific'),
                                          ('x_vehicle_ids', 'in', x_vehicle_plate),
                                          '&amp;',
                                          ('x_from_km', '&lt;=', x_km_at_repair),
                                          '|',
                                          ('x_to_km', '=', 0),
                                          ('x_to_km', '&gt;=', x_km_at_repair)]"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>