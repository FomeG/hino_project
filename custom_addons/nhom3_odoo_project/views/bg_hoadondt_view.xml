<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Kế thừa form của repair sale order -->
        <record id="view_repair_sale_order_form_inherit_electronic_invoice" model="ir.ui.view">
            <field name="name">repair.sale.order.form.inherit.electronic.invoice</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="nhom3_odoo_project.view_sale_order_form"/>
            <field name="arch" type="xml">
                <!-- Chèn tab mới vào cuối sheet -->
                <xpath expr="//sheet" position="inside">
                    <notebook>
                   <page string="Hoá đơn điện tử - Electronic Invoice">
                            <group>
                                <label for="x_electronic_invoice" string="Xuất hoá đơn điện tử - Issue Electronic Invoice"/>
                                <field name="x_electronic_invoice"
                                       string="Lấy HD VAT - Electronic Invoice"
                                       help="Cho phép tích chọn hoặc không để thực hiện xuất hoá đơn điện tử"
                                       nolabel="1"/>
                                <group invisible="not x_electronic_invoice">
                                    <field name="x_invoiced_company"
                                           string="Tên Công ty xuất HD - Invoiced Company"
                                           required="x_electronic_invoice"/>
                                    <field name="x_invoice_address"
                                           string="Địa chỉ xuất HĐ - Invoice Address"
                                           required="x_electronic_invoice"/>
                                    <field name="x_tax_code"
                                           string="Mã số thuế xuất HĐ - Tax Code"
                                           required="x_electronic_invoice"/>
                                    <field name="x_buyer"
                                           string="Người mua hàng - Buyer"
                                           required="x_electronic_invoice"/>
                                    <field name="x_email_received_invoice"
                                           string="Email nhận HĐ - Email Received Invoice"
                                           required="x_electronic_invoice"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
