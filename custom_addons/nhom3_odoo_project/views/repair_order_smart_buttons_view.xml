<odoo>
    <record id="view_repair_order_form_inherited" model="ir.ui.view">
        <field name="name">repair.quotation.form.inherited</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_view_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div" position="inside">

                <div class="oe_button_box" name="button_box">

                    <button type="object" name="action_contact"
                            class="me-2 oe_stat_button border-2 border-primary bg-light text-primary"
                            icon="fa-calendar"
                            invisible="appointment_count == 0">
                        <field name="appointment_count" widget="statinfo" string=" Appointments"/>
                    </button>

                    <button name="action_order_quotations" type="object"
                            class="me-2 oe_stat_button border-2 border-success bg-light text-success"
                            icon="fa-file-text-o"
                            invisible="False">
                        <span>Orders</span>
                    </button>

                    <button name="action_export_inv" type="object"
                            class="me-2 oe_stat_button border-2 border-info bg-light text-info"
                            icon="fa-external-link">
                        <span>Export</span>
                    </button>

                    <button name="action_customer_care" type="object"
                            class="me-2 oe_stat_button border-2 border-warning bg-light text-warning"
                            icon="fa-user-circle">
                        <span>Customer Care</span>
                    </button>

                    <button name="action_complaint" type="object"
                            class="me-2 oe_stat_button border-2 border-danger bg-light text-danger"
                            icon="fa-comments">
                        <span>Complaints</span>
                    </button>

                    <button name="action_checkout" type="object"
                            class="me-2 oe_stat_button border-2 border-secondary bg-light text-primary"
                            icon="fa-money">
                        <span>Payment Request</span>
                    </button>

                </div>
            </xpath>

            <xpath expr="//header" position="replace">
                <header>
                    <button name="button_repair_confirm" invisible="x_status != 'draft'" type="object" string="Confirm Repair"
                            class="oe_highlight"/>
                    <button name="button_repair_start" invisible="x_status != 'confirmed'" type="object"
                            string="Start Repair" class="oe_highlight"/>
                    <button name="button_repair_end" invisible="x_status != 'repairing'" type="object"
                            string="End Repair" class="oe_highlight"/>
                    <button name="button_create_sale_order" type="object" string="Create Quotation"
                            invisible="x_status == 'canceled' or sale_order_id"/>
                    <button name="button_repair_cancel" string="Cancel Repair" type="object"
                            invisible="x_status in ('completed', 'canceled')"/>
                    <button name="button_repair_cancel_draft" invisible="x_status not in ('canceled', 'completed')" string="Set to Draft"
                            type="object"/>

                    <field name="x_status" widget="statusbar"/>
                    <field name="state" widget="statusbar"/>
                </header>
            </xpath>

            <xpath expr="//header//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>