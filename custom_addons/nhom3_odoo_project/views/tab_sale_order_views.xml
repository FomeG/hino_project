                    <page string="Other Info" name="other_information">
                        <group>
                            <group name="sales_person" string="Sales">
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <field name="team_id" context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}"
                                       options="{'no_create': True}"/>
                                <field name="company_id" options="{'no_create': True}"
                                       groups="base.group_multi_company"/>
                                <field name="require_signature"/>
                                <label for="require_payment"/>
                                <div id="require_payment">
                                    <field name="require_payment"/>
                                    <span class="mx-3" invisible="not require_payment">of</span>
                                    <field name="prepayment_percent"
                                           invisible="not require_payment" widget="percentage" style="width: 3rem"/>
                                </div>
                                <field name="reference" readonly="1" invisible="not reference"/>
                                <field name="client_order_ref"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': True}"/>
                            </group>
                            <group name="sale_info" string="Invoicing">
                                <field name="show_update_fpos" invisible="1"/>
                                <label for="fiscal_position_id"/>
                                <div class="o_row">
                                    <field name="fiscal_position_id" options="{'no_create': True}"/>
                                    <button name="action_update_taxes" type="object" string=" Update Taxes"
                                            help="Recompute all taxes based on this fiscal position"
                                            class="btn-link mb-1 px-0" icon="fa-refresh"
                                            confirm="This will update all taxes based on the currently selected fiscal position."
                                            invisible="not show_update_fpos"/>
                                </div>
                                <field name="partner_invoice_id" groups="!account.group_delivery_invoice_address"
                                       invisible="1"/>
                                <field name="analytic_account_id"
                                       context="{'default_partner_id':partner_invoice_id, 'default_name':name}"

                                       groups="analytic.group_analytic_accounting" force_save="1"/>
                                <field name="journal_id" groups="base.group_no_one"/>

                                <field name="invoice_status"/>
                                <!-- test_event_configurator -->
                                <field name="invoice_status" invisible="1" groups="!base.group_no_one"/>
                            </group>
                            <group name="sale_shipping" string="Shipping">
                                <field name="incoterm"/>
                                <field name="incoterm_location"/>
                                <field name="picking_policy"/>
                                <field name="shipping_weight"/>
                                <label for="commitment_date" string="Delivery Date"/>
                                <div name="commitment_date_div" class="o_row">
                                    <field name="commitment_date"/>
                                    <span name="expected_date_span" class="text-muted">Expected:
                                        <field name="expected_date" class="oe_inline" widget="date"/>
                                    </span>
                                </div>
                            </group>
                            <group string="Tracking" name="sale_reporting">
                                <field name="origin1"/>
                                <field name="campaign_id" options="{'create_name_field': 'title'}"/>
                                <field name="medium_id"/>
                                <field name="source_id"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>




                <record id="view_tab_order_detail_inherit_history2" model="ir.ui.view">
            <field name="name">tab.order.detail.inherit.history2</field>
            <field name="model">sale.order</field>
            <!-- Kế thừa từ view chứa tab "Hoá đơn điện tử - Electronic Invoice" -->
            <field name="inherit_id" ref="nhom3_odoo_project.view_repair_sale_order_form_inherit_electronic_invoice"/> 
            <field name="arch" type="xml">
                <!-- Chèn tab mới ngay sau tab có name="order_lines_tab" -->
                <xpath expr="//page[@name='order_lines_tab']" position="after">
                    <page string="Chi tiết đơn hàng" name="order_detail_tab">
                        <field name="order_line">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="description"/>
                                <field name="product_id"/>
                                <field name="product_name" readonly="1"/>
                                <field name="product_uom" 
                                    domain="[('category_id', '=', product_id.uom_id.category_id)]"
                                    attrs="{'invisible': [('product_id', '=', False)]}"/>
                                <field name="product_uom_qty"/>
                                <field name="qty_delivered" 
                                    attrs="{'invisible': [('order_id.picking_ids.state', '!=', 'done')]}"/>
                                <field name="qty_invoiced"/>
                                <field name="price_unit" required="1"/>
                                <field name="price_subtotal"/>
                                <field name="pricelist_id"/>
                                <field name="delivery_warehouse"/>
                                <field name="percent_hmv"/>
                                <field name="percent_dealer"/>
                                <field name="discount"/>
                                <field name="tax_id"/>
                                <field name="untaxed_amount"/>
                                <field name="company_id" invisible="0"/>
                                <field name="taxes"/>
                                <field name="total"/>
                            </tree>
                        </field>
                        <!-- Hiển thị tổng hợp các giá trị -->
                        <group style="margin-top: 10px ; float: right; font-weight: bold; ">
                            <field string="Untaxed Amount: " name="amount_untaxed" readonly="1" />
                            <field string="Taxes: " name="amount_tax" readonly="1" />
                            <field string="Total: " name="amount_total" readonly="1" />
                            <field string="Total Amount: " name="amount_total" readonly="1" />

                        </group>

                    </page>
                </xpath>
            </field>
        </record>


        <record id="view_tab_sale_order_form_inherit_history" model="ir.ui.view">
            <field name="name">tab.sale.order.form.inherit.history</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form" />
            <field name="arch" type="xml">
              <xpath expr="//notebook" position="inside">
                <page string="Sale Order" name="lssc">



                </page>
              </xpath>
            </field>
          </record>
        
    </data>
</odoo>
