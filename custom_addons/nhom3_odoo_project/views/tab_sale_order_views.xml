<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Kế thừa form của repair sale order -->
        <record id="view_repair_sale_order_form_inherit_electronic_invoice" model="ir.ui.view">
            <field name="name">repair.sale.order.form.inherit.electronic.invoice</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="view_sale_order_form"/>
            <field name="arch" type="xml">
                <!-- Chèn tab mới vào cuối sheet -->
                <xpath expr="//sheet" position="inside">
                    <notebook>

                   <page string="Electronic Invoice" name="order_lines_tab">
                            <group>
                                <label for="x_electronic_invoice" string="E-Invoice"/>
                                <field name="x_electronic_invoice"
                                       string="Electronic Invoice"
                                      help="Allow selection to issue an electronic invoice"
                                       nolabel="1"/>
                                <group invisible="not x_electronic_invoice">
                                    <field name="x_invoiced_company"
                                           string="Invoiced Company"
                                           required="x_electronic_invoice"/>
                                    <field name="x_invoice_address"
                                           string="Invoice Address"
                                           required="x_electronic_invoice"/>
                                    <field name="x_tax_code"
                                           string="Tax Code"
                                           required="x_electronic_invoice"/>
                                    <field name="x_buyer"
                                           string="Buyer"
                                           required="x_electronic_invoice"/>
                                    <field name="x_email_received_invoice"
                                           string="Email Received Invoice"
                                           required="x_electronic_invoice"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>



            <!-- Kế thừa form của repair sale order -->
        <record id="view_repair_sale_order_form_inherit_other_info" model="ir.ui.view">
