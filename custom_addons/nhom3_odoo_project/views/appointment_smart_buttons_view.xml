<odoo>
    <record id="view_meeting_form_inherit" model="ir.ui.view">
        <field name="name">meeting.form.inherit.repair</field>
        <field name="model">calendar.event</field>  <!-- Replace with the correct model if different -->
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>  <!-- Replace with actual view ID -->
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_repair_orders"
                        string="Repair Orders" icon="fa-wrench"
                        class="oe_stat_button"
                        invisible="x_repair_order_count == 0">
                    <field name="x_repair_order_count" widget="statinfo" string="Repair Orders"/>
                </button>
            </xpath>

            <xpath expr="//div" position="before">
                <button name="button_appointment_confirm" invisible="appointment_status != 'draft'" type="object"
                        string="Confirm" class="me-2 oe_highlight"/>
                <button name="button_appointment_done" invisible="appointment_status != 'open'" type="object"
                        string="Finish" class="me-2 oe_highlight"/>
                <button name="button_appointment_cancel" invisible="appointment_status not in ('draft', 'open')" type="object"
                        string="Cancel" class="me-2 oe_highlight"/>
                <button name="button_appointment_draft" type="object" string="Set to Draft"
                        invisible="appointment_status not in ('canceled', 'done')"/>

                <field name="appointment_status" widget="statusbar"/>

            </xpath>
        </field>
    </record>
</odoo>