<!--                                <field name="client_order_ref"/>-->
<!--                                <field name="tag_ids"/>-->
<!--                            </group>-->
<!--                            <group string="INVOICING">-->
<!--                                <field name="fiscal_position_id"/>-->
<!--                                <field name="analytic_account_id"/>-->
<!--                                <field name="journal_id"/>-->
<!--                                <field name="invoice_status"/>-->
<!--                            </group>-->
<!--                        </group>-->
