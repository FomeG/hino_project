<odoo>
    <data>
        <!-- Kế thừa form của repair sale order -->
        <record id="view_repair_sale_order_form_inherit_other_info" model="ir.ui.view">
            <field name="name">repair.sale.order.form.inherit.other.info</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="nhom3_odoo_project.view_sale_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='order_lines_tab']" position="after">
