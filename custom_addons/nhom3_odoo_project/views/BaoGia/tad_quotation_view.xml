<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_repair_order_form_inherit_service_info2" model="ir.ui.view">
            <field name="name">repair.order.details.form.inherit.quotation2</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form" />
            <field name="arch" type="xml">
                <!-- Chèn trang mới vào sau trang có name='vehicle.information.inherit.customer.vehicle' -->
                <xpath expr="//notebook" position="inside">
                    <page string="Chi tiết đơn hàng" name="order_details">
                        <page string="Thông tin chi tiết sản phẩm" name="product_details">
                            <field name="move_ids"
                                context="{'default_repair_line_type': 'add'}"
                                domain="[('repair_line_type', '=', 'add')]">
                                <tree editable="bottom">
                                    <field name="default_code" string="Mã sản phẩm" domain="[('detailed_type', '=', 'product')]" force_save="1"/>
                                    <field name="x_product_name" string="Tên sản phẩm" force_save="1"/>
                                    <field name="x_product_alt_name" string="Tên khác" force_save="1"/>
                                    <field name="x_vehicle_plate" string="Diễn giải" />
                                    <field name="product_uom_qty" string="Số lượng" required="context.get('default_code', False)" force_save="1"/>
                                    <field name="x_delivered_qty" string="Đã giao" force_save="1"/>
                                    <field name="x_invoiced_qty" string="Đã xuất hóa đơn" force_save="1"/>
                                    <field name="product_uom" string="Đơn vị tính" 
                                        required="context.get('default_code', False)" force_save="1"
                                        domain="[('category_id', '=', product_uom_category_id)]"/>
                                    <field name="x_pricelist" string="Bảng giá" force_save="1"/>
                                    <field name="x_unit_price" string="Đơn giá" force_save="1"/>
                                    <field name="x_stock_location" string="Kho xuất" force_save="1"/>
                                    <field name="x_hmv_percent" string="% HMV" force_save="1"/>
                                    <field name="x_dealer_percent" string="% Đại lý" force_save="1"/>
                                    <field name="x_discount" string="Giảm giá" force_save="1"/>
                                    <field name="x_taxes" string="Thuế" force_save="1"/>
                                    <field name="x_tax_amount" string="Thành tiền" force_save="1"/>
                                    <field name="currency_id" column_invisible="1" />
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Trang mới: Thông tin bổ sung -->
                        <page string="Thông tin bổ sung" name="extra_info">
                            <group>
                                <field name="x_additional_notes" string="Ghi chú thêm"/>
                                <field name="x_service_warranty" string="Bảo hành dịch vụ"/>
                            </group>
                        </page>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
