<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_order_form_inherit_lsc" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.three.buttons</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="view_sale_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_button_one"
                            string="Delivery"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_button_two"
                            string="Invoice"
                            type="object"/>
                    <button name="action_button_three"
                            string=""
                            type="object"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
